# ==============================================================================
# AI Assistant - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR LOCAL RUNNING
# WARNING: NEVER COMMIT SENSITIVE SECRETS OR THE ACTUAL .env FILE TO GIT
# ==============================================================================

# Application Settings
PROJECT_NAME="Personal AI Assistant"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_ORIGIN="http://localhost:5173"

# Database Configuration (PostgreSQL with pgvector for production)
# Format: postgresql+asyncpg://user:password@localhost:5432/ai_assistant_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_assistant_dev"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Configuration (Required for distributed rate limiting in production)
REDIS_URL="redis://localhost:6379/0"

# Distributed Rate Limiting (Milestone 9)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE="redis"  # Use "memory" only for local dev/test without Redis
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PROACTIVE_LIMIT=20
RATE_LIMIT_PROACTIVE_WINDOW_SECONDS=60
RATE_LIMIT_AGENT_LIMIT=30
RATE_LIMIT_AGENT_WINDOW_SECONDS=60

# Trusted Proxy Configuration (Milestone 9)
# Comma-separated list of trusted upstream reverse-proxy IPs or CIDR blocks
TRUSTED_PROXY_IPS="127.0.0.1,::1,172.16.0.0/12"

# Security Headers & CSP (Milestone 9)
CSP_REPORT_ONLY=false
SECURE_COOKIES=false  # Set to true in production with HTTPS

# Prometheus Telemetry (Milestone 9)
METRICS_ENABLED=true
METRICS_SECRET_TOKEN=""  # Set a shared secret token to restrict access to /metrics

# Security & Encryption
# Generate secure random strings: openssl rand -hex 32
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY="replace-with-a-secure-secret-key-at-least-32-bytes"
TOKEN_ENCRYPTION_KEY="replace-with-valid-url-safe-base64-32-byte-fernet-key=="
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# LLM & Embedding Provider Configuration
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-2.0-flash"
GEMINI_MODEL="gemini-2.0-flash"

# Personal Knowledge & RAG Configuration (Milestone 7)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
MAX_GMAIL_MESSAGES_PER_INGEST=30
MAX_CALENDAR_EVENTS_PER_INGEST=30
MAX_TASKS_PER_INGEST=50
MAX_REMINDERS_PER_INGEST=50
MAX_TOTAL_DOCS_PER_REINDEX=100
MAX_TOTAL_CHUNKS_PER_INGEST=500
EMBEDDING_BATCH_SIZE=20
INGESTION_TIMEOUT_SECONDS=45
MAX_DOCUMENT_INGEST_CHARS=20000

# Voice & Multimodal Interaction (Milestone 10)
VOICE_ENABLED=true
STT_PROVIDER="gemini"  # "gemini" or "mock"
GEMINI_STT_MODEL="gemini-3.5-transcribe"
TTS_PROVIDER="mock"    # "google" or "mock"
GOOGLE_TTS_VOICE="en-US-Journey-F"
GOOGLE_TTS_LANGUAGE="en-US"
MAX_AUDIO_BYTES=10485760  # 10 MB
MAX_AUDIO_DURATION_SECONDS=60
MAX_TRANSCRIPT_CHARS=2000
MAX_TTS_CHARS=1000
VOICE_REQUEST_TIMEOUT=30
VOICE_AUDIO_PERSISTENCE=false
RATE_LIMIT_VOICE_LIMIT=20
RATE_LIMIT_VOICE_WINDOW=60
