# ==============================================================================
# AI Assistant - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR LOCAL RUNNING
# WARNING: NEVER COMMIT SENSITIVE SECRETS OR THE ACTUAL .env FILE TO GIT
# ==============================================================================

# Application Settings
PROJECT_NAME="Personal AI Assistant"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@localhost:5432/ai_assistant_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_assistant_dev"

# Security & Encryption
# Generate secure random strings: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-secret-key-at-least-32-bytes"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-fernet-compatible-key-for-oauth-tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials (Will be configured in subsequent steps)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# LLM & Embedding Provider Configuration
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-2.0-flash"
GEMINI_MODEL="gemini-2.0-flash"

# Personal Knowledge & RAG Configuration (Milestone 7)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
MAX_GMAIL_MESSAGES_PER_INGEST=30
MAX_CALENDAR_EVENTS_PER_INGEST=30
MAX_TASKS_PER_INGEST=50
MAX_REMINDERS_PER_INGEST=50
MAX_TOTAL_DOCS_PER_REINDEX=100
MAX_TOTAL_CHUNKS_PER_INGEST=500
EMBEDDING_BATCH_SIZE=20
INGESTION_TIMEOUT_SECONDS=45
MAX_DOCUMENT_INGEST_CHARS=20000

